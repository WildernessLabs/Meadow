{
    "name": "Meadow Build",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "vscode",
    "remoteEnv": {
        "TERM": "xterm-256color"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": [
                            "-l"
                        ]
                    }
                }
            }
        }
    }
}
