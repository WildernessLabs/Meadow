    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdb",
            "request": "attach",
            "name": "Debug on Meadow",
            "executable": "${workspaceFolder}/nuttx/nuttx.elf",
            "cwd": "${workspaceFolder}/gdb-vscode",
            "gdbpath": "/opt/homebrew/bin/arm-none-eabi-gdb-py",
            "target": "extended-remote :4242",
            "remote": false
        }
    ]
}