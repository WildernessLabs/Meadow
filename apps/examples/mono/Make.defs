ifeq ($(CONFIG_EXAMPLES_MONO),y)
  CONFIGURED_APPS += examples/mono
  MBEDTLS_DIR = $(TOPDIR)/../mbedtls

  SQLITE_DIR =  $(TOPDIR)/../apps/examples/sqlite
  SQLITE_OBJS = $(SQLITE_DIR)/sqlite_compile_sqlite3.o

  # .NET 10 Mono runtime — single mega-library plus component plugins.
  # MONO_CONFIG selects which CMake config we link in. Must match the
  # config build-mono.sh was last run with (Debug → build-nuttx-debug,
  # Release → build-nuttx-release). Set via env or override on the make
  # command line; default is Release.
  MONO_CONFIG ?= release
  MONO_BUILD_DIR = $(TOPDIR)/../../runtime/src/mono/build-nuttx-$(MONO_CONFIG)/mono

  MONO_AOBJS = $(MONO_BUILD_DIR)/mini/libmonosgen-2.0.a \
               $(MONO_BUILD_DIR)/mini/libmono-component-marshal-ilgen-static.a \
               $(MONO_BUILD_DIR)/mini/libmono-component-hot_reload-stub-static.a \
               $(MONO_BUILD_DIR)/mini/libmono-component-debugger-stub-static.a \
               $(MONO_BUILD_DIR)/mini/libmono-component-diagnostics_tracing-stub-static.a \
               $(MONO_BUILD_DIR)/minipal/minipal/libminipal.a \
               $(MONO_BUILD_DIR)/minipal/minipal/libaotminipal.a \
               $(MONO_BUILD_DIR)/sgen/libsgen_objects.a \
               $(MONO_BUILD_DIR)/../system_native/libSystem.Native.a

  MBEDTLS_AOBJS = $(MBEDTLS_DIR)/library/libmbedcrypto.a \
               $(MBEDTLS_DIR)/library/libmbedtls.a \
               $(MBEDTLS_DIR)/library/libmbedx509.a

  # Errno-syncing wrappers: intercept POSIX syscalls so that on failure,
  # the kernel's TCB errno is synced into _mono_errno_val (the static
  # that PAL code reads via the errno.h override).  See mono_nuttx_stubs.c.
  ERRNO_WRAP_SYMS = socket connect bind listen accept \
                    getsockopt setsockopt getsockname getpeername \
                    send sendto recv recvfrom \
                    close read write open fcntl ioctl lseek \
                    fstat stat ftruncate poll select pipe2 \
                    sem_wait sem_trywait sem_timedwait sem_post

  # Full-replacement wrappers: redirect calls away from NuttX's proxy/kernel
  # mmap (which lacks file-backed mapping support we need) to our SDRAM-cached
  # impl in mono_nuttx_stubs.c. Same --wrap mechanism, but the wrapper does
  # not delegate to __real_mmap.
  REPLACE_WRAP_SYMS = mmap munmap

  MONO_LDLIBS = $(addprefix --wrap=,$(ERRNO_WRAP_SYMS) $(REPLACE_WRAP_SYMS))

  MONO_LIBM=
else
  MONO_AOBJS =
  MONO_LIBM=
endif
