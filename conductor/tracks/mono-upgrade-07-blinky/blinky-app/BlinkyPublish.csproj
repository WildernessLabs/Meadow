<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BlinkyPublish</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- IL Trimming configuration -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-arm</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference the pre-built Meadow assemblies as DLL references, NOT project references.
         This avoids propagating PublishTrimmed to multi-targeted source projects. -->
    <Reference Include="Meadow">
      <HintPath>/Users/lexas/Meadow.Core/source/Meadow.Core/bin/Release/net9.0/Meadow.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.F7">
      <HintPath>/Users/lexas/Meadow.Core/source/implementations/f7/Meadow.F7/bin/Release/net9.0/Meadow.F7.dll</HintPath>
    </Reference>
    <Reference Include="BlinkyCS">
      <HintPath>/Users/lexas/Meadow/conductor/tracks/mono-upgrade-07-blinky/blinky-app/bin/Release/net9.0/BlinkyCS.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.Contracts">
      <HintPath>/Users/lexas/Meadow.Contracts/Source/Meadow.Contracts/bin/Release/net9.0/Meadow.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.Logging">
      <HintPath>/Users/lexas/Meadow.Logging/Source/Meadow.Logging/lib/bin/Release/net9.0/Meadow.Logging.dll</HintPath>
    </Reference>
    <Reference Include="Meadow.Units">
      <HintPath>/Users/lexas/Meadow.Units/Source/Meadow.Units/bin/Release/net9.0/Meadow.Units.dll</HintPath>
    </Reference>
    <Reference Include="MicroJson">
      <HintPath>/Users/lexas/Meadow.Foundation/Source/Meadow.Foundation.Libraries_and_Frameworks/Serialization.MicroJson/Driver/bin/Release/net9.0/MicroJson.dll</HintPath>
    </Reference>
    <Reference Include="NetEscapades.Configuration.Yaml">
      <HintPath>/Users/lexas/Meadow.Core/source/implementations/f7/Meadow.F7/bin/Release/net9.0/NetEscapades.Configuration.Yaml.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Preserve all types in Meadow assemblies — they use reflection extensively -->
    <TrimmerRootAssembly Include="Meadow" />
    <TrimmerRootAssembly Include="Meadow.F7" />
    <TrimmerRootAssembly Include="BlinkyCS" />
    <TrimmerRootAssembly Include="Meadow.Contracts" />
    <TrimmerRootAssembly Include="Meadow.Logging" />
    <TrimmerRootAssembly Include="Meadow.Units" />
    <TrimmerRootAssembly Include="MicroJson" />
  </ItemGroup>
</Project>
