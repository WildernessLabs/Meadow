<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>App</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Give each test file a unique class name (BasicTests, ArrayTests, etc.) -->
    <DefineConstants>__MOBILE__</DefineConstants>
  </PropertyGroup>

  <!-- Mono mini test infrastructure (always included) -->
  <ItemGroup>
    <Compile Remove="TestDriver.cs" />
    <Compile Include="TestDriver.cs" />
    <Compile Include="/Users/lexas/runtime/src/mono/mono/mini/TestHelpers.cs" Link="tests/TestHelpers.cs" />
  </ItemGroup>

