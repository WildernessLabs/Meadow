- # CONFIG_READLINE_ECHO is not set
+ CONFIG_FS_PROCFS=y
+ CONFIG_FS_PROCFS_REGISTER=y
+ CONFIG_NSH_ALTCONDEV=y
+ CONFIG_NSH_ALTSTDERR="/dev/ttyS3"
+ CONFIG_NSH_ALTSTDIN="/dev/ttyS3"
+ CONFIG_NSH_ALTSTDOUT="/dev/ttyS3"
+ CONFIG_NSH_DISABLE_IFCONFIG=y
+ CONFIG_NSH_DISABLE_IFUPDOWN=y
+ CONFIG_NSH_READLINE=y
+ CONFIG_READLINE_CMD_HISTORY=y
+ CONFIG_STM32F7_USART6=y
+ CONFIG_SYSTEM_CLE=y
+ CONFIG_SYSTEM_CLE_CMD_HISTORY=y
+ CONFIG_SYSTEM_NSH=y
+ CONFIG_SYSTEM_NSH_PRIORITY=180
+ CONFIG_SYSTEM_NSH_STACKSIZE=4096


